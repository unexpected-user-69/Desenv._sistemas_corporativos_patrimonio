# Este é um arquivo de exemplo para as variáveis de ambiente de produção.
# Copie este arquivo para .env.prod e substitua os valores CHANGEME.
# NUNCA comite o arquivo .env.prod no repositório.

# Configurações de conexão com o PostgreSQL
# Exemplo de configuração para ambiente de produção
# Preencha com valores reais antes de subir em produção

# JWT
JWT_ACCESS_SECRET=preencha_com_um_segredo_forte
JWT_REFRESH_SECRET=preencha_com_um_segredo_forte

# Banco de Dados
DATABASE_URL=postgres://usuario:senha@host:porta/db

# Outras variáveis necessárias para os serviços
# Exemplo:
# USERS_API_URL=http://users-service:3010
# AUTH_API_URL=http://auth-service:3011
# EVENTS_API_URL=http://events-service:3012

# Segredo JWT para assinar os tokens de acesso.
# Você pode gerar um segredo seguro com o comando: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGEME_YOUR_JWT_SECRET

# Tags das imagens a serem usadas. O padrão é 'latest'.
# Descomente para usar uma versão específica.
# USERS_IMAGE_TAG=latest
# AUTH_IMAGE_TAG=latest
# EVENTS_IMAGE_TAG=latest