# ⚠️ CONFIGURAÇÃO DE PRODUÇÃO
# Copie este arquivo para .env.production e configure os valores adequados
# NUNCA commite arquivos .env com secrets reais no Git

# Configurações do Banco de Dados
DB_HOST=seu_host_producao
DB_PORT=5432
DB_USER=seu_usuario_producao
DB_PASS=sua_senha_producao
DB_NAME=patrimonio_inventario
DB_SSL=true
DB_LOGGING=false
# DATABASE_URL alternativa (sobrescreve variáveis individuais acima)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Configurações do Backend
BACKEND_PORT=3101
NODE_ENV=production

# Configurações do Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=https://seu-dominio.com
VITE_APP_NAME=Patrimônio Inventário

# Configurações de Segurança
# ⚠️ Gere valores seguros usando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_PEPPER=seu_pepper_aleatorio_64_caracteres_aqui
HASH_SALT_ROUNDS=12

# Configurações de Autenticação JWT
# ⚠️ CRÍTICO: Gere secrets seguros de 64 caracteres (32 bytes em hex) para produção
# Use: node -e "console.log('JWT_ACCESS_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
# Use: node -e "console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
# Veja docs/JWT_SECRETS_SETUP.md para instruções completas
JWT_ACCESS_SECRET=SEU_SECRET_ACCESS_64_CARACTERES_AQUI_GERE_UM_NOVO
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=SEU_SECRET_REFRESH_64_CARACTERES_AQUI_GERE_UM_NOVO
REFRESH_EXPIRES_DAYS=7
DEV_AUTO_AUTH=false

# Configurações do Users Service (para comunicação HTTP)
# URL base do Users Service (usado pelo UsersHttpClient no AuthModule)
# 
# Para DESENVOLVIMENTO LOCAL (mesma aplicação):
#   USERS_API_URL=http://localhost:3101/v1
#
# Para DOCKER COMPOSE (serviço separado):
#   USERS_API_URL=http://users:3000
#
# Para PRODUÇÃO (serviço externo):
#   USERS_API_URL=https://api-usuarios.seudominio.com/v1
#
USERS_API_URL=http://users:3000
# Timeout para requisições HTTP ao Users Service (em milissegundos)
USERS_API_TIMEOUT=5000

# CORS
CORS_ORIGIN=https://seu-dominio.com,https://www.seu-dominio.com

