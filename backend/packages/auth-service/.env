# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patrimonio_inventario
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=patrimonio_inventario
DB_SSL=false
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# Users Service
USERS_SERVICE_URL=http://localhost:3002
USERS_SERVICE_TIMEOUT=5000

# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# Hash
HASH_SALT_ROUNDS=10
HASH_PEPPER=

# SERVICE_TOKEN - Autenticação Service-to-Service
# Token compartilhado para comunicação segura entre microsserviços internos
# IMPORTANTE: Este token deve ser o mesmo em todos os serviços que se comunicam
SERVICE_TOKEN=fe39415df8d08226b2c19d09fa632b8c8f0d9bfb45b1ac7c4cfe2d53e671782a
