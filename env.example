# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=patrimonio_inventario
DB_SSL=false
DB_LOGGING=false
# DATABASE_URL alternativa (sobrescreve variáveis individuais acima)
# DATABASE_URL=postgresql://user:password@host:port/database

# Configurações do Backend
BACKEND_PORT=3101
NODE_ENV=development

# Configurações do Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3101
VITE_APP_NAME=Patrimônio Inventário

# Configurações de Segurança
HASH_PEPPER=your-pepper-here
HASH_SALT_ROUNDS=12

# Configurações de Autenticação JWT
# ⚠️ IMPORTANTE: Gere secrets seguros para produção usando:
# node -e "console.log('JWT_ACCESS_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
# node -e "console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
# Veja docs/JWT_SECRETS_SETUP.md para mais detalhes
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
REFRESH_EXPIRES_DAYS=7
DEV_AUTO_AUTH=false

# Configurações do Users Service (para comunicação HTTP)
# URL base do Users Service (usado pelo UsersHttpClient no AuthModule)
# Em ambiente Docker Compose, use o nome do serviço: http://users:3000
# Em desenvolvimento local, use: http://localhost:3101
USERS_API_URL=http://users:3000
# Timeout para requisições HTTP ao Users Service (em milissegundos)
USERS_API_TIMEOUT=5000
