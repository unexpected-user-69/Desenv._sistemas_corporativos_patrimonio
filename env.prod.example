# ========================================================================
# Sistema de Gestão de Patrimônio - Produção
# ========================================================================
# IMPORTANTE: Copie este arquivo para .env.prod e substitua TODOS os valores CHANGEME
# NUNCA comite o arquivo .env.prod no repositório!
#
# Gerar segredos seguros:
#   - JWT secrets:  openssl rand -hex 32
#   - HASH_PEPPER:  openssl rand -hex 32
# ========================================================================

# ========================================================================
# CONFIGURAÇÕES GERAIS
# ========================================================================
NODE_ENV=production
REPO_OWNER=CHANGEME_SEU_USUARIO_GITHUB

# ========================================================================
# BANCO DE DADOS POSTGRESQL
# ========================================================================
# Credenciais do PostgreSQL (container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_SENHA_SUPER_FORTE_AQUI
POSTGRES_DB=patrimonio_inventario

# Configuração de conexão usada pelos serviços
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=CHANGEME_SENHA_SUPER_FORTE_AQUI
DB_NAME=patrimonio_inventario
DB_SSL=false
DB_LOGGING=false
DB_SYNC_TEST=false

# ========================================================================
# AUTENTICAÇÃO JWT
# ========================================================================
# IMPORTANTE: Use openssl rand -hex 32 para gerar segredos fortes
JWT_ACCESS_SECRET=CHANGEME_USE_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGEME_USE_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ========================================================================
# HASH DE SENHAS
# ========================================================================
# IMPORTANTE: Use openssl rand -hex 32 para gerar um pepper forte
HASH_PEPPER=CHANGEME_USE_OPENSSL_RAND_HEX_32
HASH_SALT_ROUNDS=12

# ========================================================================
# SERVICE TOKEN (para comunicação entre microsserviços)
# ========================================================================
# IMPORTANTE: Use openssl rand -hex 32 para gerar um token forte
SERVICE_TOKEN=CHANGEME_USE_OPENSSL_RAND_HEX_32

# ========================================================================
# SWAGGER (DESENVOLVIMENTO - DESABILITAR EM PRODUÇÃO)
# ========================================================================
SWAGGER_ENABLED=false
SWAGGER_DEV_EMAIL=admin@admin.local
SWAGGER_DEV_PASSWORD=AdminPassword123!
SWAGGER_DEV_NAME=admin
DEV_AUTO_AUTH=false

# ========================================================================
# TAGS DAS IMAGENS DOCKER
# ========================================================================
# Use 'latest' para a versão mais recente, ou especifique uma tag/commit específico
USERS_IMAGE_TAG=latest
AUTH_IMAGE_TAG=latest
PATRIMONIO_IMAGE_TAG=latest
CATEGORIAS_IMAGE_TAG=latest
AUDIT_IMAGE_TAG=latest
EVENTS_IMAGE_TAG=latest
GATEWAY_IMAGE_TAG=latest

# ========================================================================
# VERIFICAÇÃO DE ASSINATURAS (OPCIONAL)
# ========================================================================
# Se true, requer cosign instalado e cosign.pub na raiz
COSIGN_VERIFY=false

# ========================================================================
# CONFIGURAÇÕES DOS SERVIÇOS
# ========================================================================

# API Gateway
API_GATEWAY_PORT=3100

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_API_URL=http://auth-service:3001

# Users Service
USERS_SERVICE_PORT=3002
USERS_API_URL=http://users-service:3002

# Patrimonio Service
PATRIMONIO_SERVICE_PORT=3003
PATRIMONIO_API_URL=http://patrimonio-service:3003

# Categorias Service
CATEGORIAS_SERVICE_PORT=3004
CATEGORIAS_API_URL=http://categorias-service:3004

# Audit Service
AUDIT_SERVICE_PORT=3005
AUDIT_API_URL=http://audit-service:3005

# Events Service
EVENTS_SERVICE_PORT=3006
EVENTS_API_URL=http://events-service:3006

# ========================================================================
# RATE LIMITING
# ========================================================================
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ========================================================================
# UPLOADS (PATRIMONIO SERVICE)
# ========================================================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ========================================================================
# OBSERVABILIDADE (OPCIONAL)
# ========================================================================
# Se você usar ferramentas como Prometheus, Grafana, Sentry, etc.
# SENTRY_DSN=
# PROMETHEUS_PORT=9090

